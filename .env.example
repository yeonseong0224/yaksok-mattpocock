# 환경 변수 예시 파일 -> 실제 환경 변수는 .env 파일에 작성합니다

# 개발 DB — 각자 본인 Neon 연결 문자열을 .env 에 넣습니다
DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/neondb?sslmode=require"
# 로컬 Docker DB를 쓸 경우 (docker compose up -d 후)
# DATABASE_URL="postgresql://yaksok:yaksok@localhost:5432/yaksok"

# 테스트 DB (npm test). 로컬 Docker 안의 별도 DB이며, 없으면 첫 실행 때 만들어집니다. 이름은 _test로 끝나야 합니다
TEST_DATABASE_URL="postgresql://yaksok:yaksok@localhost:5432/yaksok_test"

# 서비스 기본 URL (초대 링크 만들 때 사용)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# 카카오 (발급 후 채움)
KAKAO_REST_API_KEY=""
KAKAO_SKILL_SECRET=""

# 네이버 지도 (발급 후 채움)
NAVER_MAP_CLIENT_ID=""
NAVER_MAP_CLIENT_SECRET=""